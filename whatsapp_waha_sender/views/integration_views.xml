<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Lead -->
    <record id="crm_lead_view_form_waha" model="ir.ui.view">
        <field name="name">crm.lead.form.waha</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_whatsapp" type="object"
                        string="Send WhatsApp" class="btn-secondary"
                        icon="fa-whatsapp"/>
            </header>
        </field>
    </record>

    <!-- Sales Order -->
    <record id="sale_order_view_form_waha" model="ir.ui.view">
        <field name="name">sale.order.form.waha</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_whatsapp" type="object"
                        string="Send WhatsApp" class="btn-secondary"
                        icon="fa-whatsapp"/>
            </header>
        </field>
    </record>

    <!-- Invoice (account.move) -->
    <record id="account_move_view_form_waha" model="ir.ui.view">
        <field name="name">account.move.form.waha</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_whatsapp" type="object"
                        string="Send WhatsApp" class="btn-secondary"
                        icon="fa-whatsapp"/>
            </header>
        </field>
    </record>

    <!-- Contact (res.partner) -->
    <record id="res_partner_view_form_waha" model="ir.ui.view">
        <field name="name">res.partner.form.waha</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <div class="oe_button_box">
                    <button name="action_send_whatsapp" type="object"
                            string="Send WhatsApp" class="oe_stat_button"
                            icon="fa-whatsapp"/>
                </div>
            </sheet>
        </field>
    </record>
</odoo>
