<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waha_composer_form" model="ir.ui.view">
        <field name="name">waha.composer.form</field>
        <field name="model">waha.composer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="account_id"/>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <field name="template_id"/>
                    <field name="attach_invoice_pdf"
                           invisible="model != 'account.move'"/>
                </group>
                <field name="body" widget="text" placeholder="Type your message..."/>
                <field name="attachment_ids" widget="many2many_binary"
                       invisible="attach_invoice_pdf == True"/>
                <footer>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_waha_mass_composer_form" model="ir.ui.view">
        <field name="name">waha.mass_composer.form</field>
        <field name="model">waha.mass_composer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="account_id"/>
                    <field name="template_id"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids" invisible="1"/>
                </group>
                <field name="body" widget="text" placeholder="Message sent to every selected record..."/>
                <footer>
                    <button name="action_send" type="object" string="Send to All"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
