<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact (res.partner): chat of this contact; if company, one tab per contact -->
    <record id="res_partner_view_form_waha_chat" model="ir.ui.view">
        <field name="name">res.partner.form.waha.chat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[1]" position="inside">
                <page string="WhatsApp Chat" name="waha_chat">
                    <field name="waha_chat_html" widget="html" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

