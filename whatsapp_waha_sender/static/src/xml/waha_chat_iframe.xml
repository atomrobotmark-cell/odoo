<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_waha_sender.WahaChatIframe">
        <t t-if="props.value">
            <div class="mb8">
                <a t-attf-href="{{ props.value }}" target="_blank"
                   class="btn btn-sm btn-secondary">Open in new window</a>
                <span class="text-muted">Read-only WhatsApp history (synced from WAHA).</span>
            </div>
            <iframe t-attf-src="{{ props.value }}"
                    style="width:100%;height:620px;border:1px solid #ccc;border-radius:6px;"/>
        </t>
        <t t-else="">
            <p class="text-muted">No related contact / phone number, so there is no WhatsApp chat to show.</p>
        </t>
    </t>
</templates>
